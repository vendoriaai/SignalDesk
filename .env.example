# SignalDesk secrets — copy to .env (never commit the real file)
# LLM provider (BYOK); any LiteLLM-compatible key. Optional for the headless core.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Web search: Tavily preferred; DuckDuckGo fallback needs the `search` extra.
TAVILY_API_KEY=
# Macro (FRED) and Forex history (Alpha Vantage) — free keys; yfinance is the fallback.
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
# Cloud sync (Supabase) — used from milestone M3 onward.
SUPABASE_URL=
SUPABASE_ANON_KEY=
